# ─────────────────────────────────────────────────────────────
# Serveur
# ─────────────────────────────────────────────────────────────
PORT=3001
# URL publique de l'API (sert à construire les URLs /uploads/...).
# En local : http://localhost:3001
PUBLIC_URL=http://localhost:3001
# URL du front (redirections Stripe Checkout / portail).
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Base de données PostgreSQL
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=juju
DB_PASSWORD=changeme
DB_NAME=juju

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# ─────────────────────────────────────────────────────────────
# Essayage IA (FASHN)
# ─────────────────────────────────────────────────────────────
FASHN_API_KEY=

# ─────────────────────────────────────────────────────────────
# Paiement Premium (Stripe) — essayages illimités, 9,99 €/mois
# ─────────────────────────────────────────────────────────────
# Clé secrète : Dashboard Stripe → Développeurs → Clés API
STRIPE_SECRET_KEY=sk_test_xxx
# ID du prix de l'abonnement (Produits → ton produit → Prix → price_...)
STRIPE_PREMIUM_PRICE_ID=price_xxx
# Secret de signature du webhook (Développeurs → Webhooks → ton endpoint).
# En local : `stripe listen --forward-to localhost:3001/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx
